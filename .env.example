# Memory backend: "local" (mock, works offline) or "hindsight" (real).
MEMORY_BACKEND=local
# Local mock store location
MEMORY_PATH=data/memory.json
DEALS_PATH=data/deals.json
# Call receipt journal (idempotent retries). Defaults next to MEMORY_PATH for
# local mode; set explicitly when MEMORY_BACKEND=hindsight.
# RECEIPTS_PATH=data/receipts.json

# Real Hindsight (Hindsight Cloud or local docker on :8888)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# Use a unique prefix for your team/environment.
HINDSIGHT_BANK_PREFIX=deal-

# LLM for briefs/follow-ups. Empty = template fallback (demo still works).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
